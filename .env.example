###############################################################################
# CNI CRM — ENVIRONMENT TEMPLATE
#
#   Copy to .env.local and fill in the values:   cp .env.example .env.local
#
#   .env.local is git-ignored and must stay that way. Real values belong in
#   exactly two places: your .env.local, and the Vercel dashboard. Never in a
#   commit, never in a chat message, never in a screenshot. (doc 16 §8)
#
#   ⛔ Nobody should ever send me these values. I do not need them — the
#      database work is done through the Supabase MCP, which authenticates as
#      you. This file exists so YOU can fill it in locally.
#
#   Legend
#     ▶ NEEDED NOW      — required before Step 4 (authentication) can run
#     ○ NEEDED SOON     — required by the step named
#     · LATER           — Phase 2+
###############################################################################


# ─────────────────────────────────────────────────────────────────────────────
# ▶ DATABASE — Supabase Postgres, project xmqcmbbgbyuohpzywote
# ─────────────────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string
#
# ⚠️ THREE THINGS MATTER HERE. The second is a security control, and the third
#    fails in a way that makes the database look misconfigured when it is not.
#
#   1. Use the POOLED connection (Transaction mode, port 6543) for the app.
#      Serverless functions open and close connections constantly; the direct
#      port 5432 connection will exhaust its limit.
#
#   2. Append   ?options=-c%20role%3Dcni_app   to DATABASE_URL.
#
#      That makes every session start as `cni_app`, which does NOT bypass
#      row-level security. Without it the app runs as `postgres`, which DOES
#      bypass it — and half the security model silently stops existing.
#      See lib/db/README.md §2.
#
#   3. ⚠️ PERCENT-ENCODE THE PASSWORD. Two separate traps, and `$` is the one
#      that wasted an hour (session 2026-08-14, new Supabase project):
#
#        `$`  Next.js loads this file through dotenv + dotenv-expand, which
#             reads `$anything` as a VARIABLE REFERENCE and substitutes it —
#             usually with nothing. The app then gets a password missing a
#             chunk and reports `28P01 password authentication failed`.
#             `npm run check:db` PASSES while the app FAILS, because that
#             script has its own parser and does no expansion. Encode it %24.
#
#        `@ ? # / : %`  URL-reserved. `#` starts a fragment, so a parser throws
#             away the host, port, database and the ?options= suffix.
#             Encode: %40 %3F %23 %2F %3A %25  (encode % FIRST if you do it
#             by hand, or every other escape gets double-encoded).
#
#      postgres.js URL-decodes the password, so an encoded string is correct
#      everywhere — locally, and pasted into Vercel. Simplest escape from all
#      of it: reset the database password to letters and digits only.
#
# Example shape (not a real credential):
#   postgresql://postgres.xmqcmbbgbyuohpzywote:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?options=-c%20role%3Dcni_app
DATABASE_URL=

# ○ Step 4 · Session mode (port 5432), no role override. For migrations and
#   anything that needs prepared statements. Not used at request time.
DIRECT_DATABASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# ▶ APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
# The base URL used to build activation, reset and unlock links.
#
# ⚠️ OPTIONAL SINCE SESSION 20, AND USUALLY BEST LEFT UNSET.
#
# lib/app-url.ts now derives the origin from the REQUEST when this is empty, so
# a link is correct on localhost, on the LAN, on a Vercel preview with its own
# generated hostname, and in production, with nothing to keep in step.
#
# Setting it to a fixed value is what caused the bug this replaced: with
# `http://localhost:4310` here, every invitation and reset link said localhost —
# including ones opened from a phone or another machine on the network, where
# they are simply dead. The failure is silent: the link is well-formed, the mail
# sends, and it is only useless when somebody clicks it.
#
# Set it ONLY when you need to pin the origin — for example if this is ever
# deployed behind a proxy you do not control, since a fixed value cannot be
# influenced by a request header. It also covers the case of a link built with
# no request in scope, such as the cron digest.
#
# No trailing slash. Leave blank to derive it.
NEXT_PUBLIC_APP_URL=


# ─────────────────────────────────────────────────────────────────────────────
# ○ Step 4 · SECRETS — generate these, do not invent them by hand
# ─────────────────────────────────────────────────────────────────────────────
# Generate each with:   openssl rand -base64 32
# (or, on Windows PowerShell:
#    [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 })) )
#
# Signs and encrypts the session cookie. Rotating it signs everyone out —
# which is exactly what you want after any staff change (doc 16 §8).
SESSION_SECRET=

# Encrypts mfa_factors.secret_encrypted — the TOTP seeds. doc 04 §2b requires
# these encrypted at rest.
#
# ⚠️ Lose this and every enrolled authenticator stops working, for everyone,
#    permanently. Recovery is then printed recovery codes only (SA-9). Back it
#    up somewhere that is not this repository and not this machine.
MFA_ENCRYPTION_KEY=

# Added to a token before hashing, so a stolen database dump alone cannot be
# brute-forced against the 6-digit recovery codes (FR-155). A 6-digit code has
# a million possibilities — trivial to enumerate against a bare SHA-256.
TOKEN_PEPPER=


# ─────────────────────────────────────────────────────────────────────────────
# ○ Step 5 · EMAIL — Resend
# ─────────────────────────────────────────────────────────────────────────────
#
# ⛔⛔ THIS FILE IS COMMITTED TO GIT. NEVER PUT A REAL VALUE IN IT. ⛔⛔
#     A key pasted here goes to GitHub on the next commit. Real values belong
#     in .env.local, which is git-ignored. A live Resend key was pasted here
#     once (Session 08) and removed before it committed — that key is burned
#     and must be revoked in the Resend dashboard.
#
# resend.com/api-keys · free tier is 3,000 emails/month, ample for 7 people.
RESEND_API_KEY=

# ── SANDBOX vs REAL DOMAIN ───────────────────────────────────────────────────
# For development, Resend's shared sender needs no DNS setup at all:
#
#     EMAIL_FROM="CNI CRM <onboarding@resend.dev>"
#
# ⚠️ ONE LIMITATION, AND IT MATTERS FOR TESTING: the sandbox sender can only
#    deliver to the email address that owns the Resend account. Invitations to
#    anyone else are accepted by the API and silently never arrive. So the
#    Step 5 flow can be tested end to end by ONE person, and the whole team
#    cannot be onboarded until a real domain is verified.
#
# For production, use your own verified domain:
#     EMAIL_FROM="CNI CRM <no-reply@yourdomain.com>"
EMAIL_FROM="CNI CRM <onboarding@resend.dev>"

# Where the Super Admin's security alerts go (FR-151: every sign-in, every
# anomaly). Can be the same as the Super Admin's login address.
# On the sandbox sender this MUST be the Resend account's own address.
SECURITY_ALERT_EMAIL=

# ⚠️ NOT AN ENVIRONMENT VARIABLE. REQUIRED BEFORE GOING LIVE, NOT BEFORE
#    TESTING (doc 20 §9, 2.1): verify the real sending domain in Resend and set
#    SPF, DKIM and DMARC on it. Without them, password-reset and invitation
#    emails are filtered — and the entire recovery design (ADR-007) assumes
#    they arrive. The sandbox sender above is fine until then.


# ─────────────────────────────────────────────────────────────────────────────
# ○ Step 7 · FILE ATTACHMENTS — Supabase Storage
# ─────────────────────────────────────────────────────────────────────────────
# Authentication is our own (registry C-13) and the app speaks SQL, not
# PostgREST, so the anon key has no role at request time — migration 005 revoked
# its privileges on `public`.
NEXT_PUBLIC_SUPABASE_URL=https://xmqcmbbgbyuohpzywote.supabase.co

# The bucket. Already created, already private, 25 MB cap, allow-listed types.
SUPABASE_STORAGE_BUCKET="CNI-Task Management Docs"

# ── ▲ THE ONE PRIVILEGED CREDENTIAL, AND WHY IT IS NOT THE FORBIDDEN ONE ─────
#
#   Supabase dashboard → Project Settings → API keys → SECRET key
#   (older projects call it `service_role`)
#
# The rule below still stands and has NOT been relaxed: nothing in this
# application reads or writes `public.*` with an elevated key. Every database
# query goes through `withUser()` as the NOBYPASSRLS role `cni_app`, and the
# whole identity model (C-14, C-18) depends on that staying true.
#
# Storage is a different problem with no equivalent answer. It is a separate
# HTTP service — it cannot see `app.user_id`, the transaction-local setting our
# row-level security is built on, because it is not on our connection and not
# in our transaction. So a private bucket cannot be authorised the way
# everything else here is. The alternatives are worse:
#
#   a public bucket      every file readable by URL, forever, by anyone
#   the publishable key  it ships to the browser, so granting it bucket access
#                        is a public bucket with extra steps
#
# The containment is enforced, not promised:
#
#   1. lib/storage/bucket.ts reads this variable and NOTHING ELSE DOES.
#      `npm run lint` fails the build if another file mentions it — the rule is
#      in eslint.config.mjs, with the reasoning.
#   2. That module exports four narrow functions and never returns a client, so
#      no caller can reach past it to the database side of the API.
#   3. Every caller is a server action that has already run `requireUser()` and
#      had RLS confirm the person can see the task. The key moves bytes; it
#      never decides who may see them.
#
# ⛔ It is a SERVER variable. It must never gain a NEXT_PUBLIC_ prefix — that
#    would compile it into the browser bundle and hand every visitor full
#    storage access.
#
# Verify it with:   npm run storage:check
#   Uploads a test file, signs a link, downloads it back, confirms the bucket
#   refuses unsigned access, and deletes it. Never prints the key.
SUPABASE_STORAGE_KEY=

# ⛔ Do NOT use the key above — or any other — for database access. It bypasses
#    row-level security entirely, and half the security model stops existing.


# ─────────────────────────────────────────────────────────────────────────────
# ○ Step 8 · THE DAILY DIGEST
# ─────────────────────────────────────────────────────────────────────────────
# Vercel Cron calls GET /api/digest each working morning (vercel.json). The
# route refuses without this token, compared in constant time.
#
# ⛔ WITHOUT IT THE ENDPOINT IS DISABLED, NOT OPEN. That is deliberate: an
#    unauthenticated route that emails the whole division is a spam cannon with
#    a company logo on it, so the failure mode is "off", never "public".
#
# Generate one:   openssl rand -base64 32
#
# Vercel supplies this header to its own cron invocations automatically when the
# variable is set in the project — so set it in Vercel, and locally only if you
# want to test the route by hand:
#
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:4310/api/digest
CRON_SECRET=

# ---------------------------------------------------------------------------
# GOOGLE DRIVE  (optional — the Documents screen works without it)
# ---------------------------------------------------------------------------
# An OAuth 2.0 "Web application" client from Google Cloud. NOT a service account.
#
# ⚠️ WHY NOT A SERVICE ACCOUNT (changed 2026-08-16) ─────────────────────────────
#    A service account has no Drive storage of its own, so a file it uploads is
#    owned by it and Google refuses with "Service Accounts do not have storage
#    quota". Listing folders works fine — only the approval step breaks — which
#    made it a late and confusing failure. The escapes are a Shared Drive or
#    domain-wide delegation, and both need Google Workspace. This division's
#    account is a consumer @gmail.com, so the CRM acts AS that account instead.
#
# These two only make the Connect button possible. Somebody then presses it on
# the Documents screen and grants access once; the refresh token that comes back
# is sealed and stored in the database, never here.
#
# ⚠️ Both redirect URIs must be registered on the client in Google Cloud:
#       http://localhost:4310/api/drive/callback
#       https://<your-deployment>/api/drive/callback
#    A missing one shows as redirect_uri_mismatch on Google's own screen.
#
# Full instructions: docs/GOOGLE-DRIVE-SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
